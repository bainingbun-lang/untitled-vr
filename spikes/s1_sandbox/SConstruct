#!/usr/bin/env python

import os

godot_cpp = os.path.abspath("../../../tools/godot-cpp")

env = Environment(ENV=os.environ)
env["SHLIBPREFIX"] = ""
env["SHLIBSUFFIX"] = ".so"

env.Append(CXXFLAGS=["-std=c++17", "-fPIC", "-O2", "-fno-exceptions"])
env.Append(CPPDEFINES=[
    "DEBUG_ENABLED",
    "NDEBUG",
    "THREADS_ENABLED",
    "HOT_RELOAD_ENABLED",
    "LINUX_ENABLED",
    "UNIX_ENABLED",
])
env.Append(CPPPATH=[
    "src",
    os.path.join(godot_cpp, "include"),
    os.path.join(godot_cpp, "gen", "include"),
    os.path.join(godot_cpp, "gdextension"),
])
env.Append(LIBPATH=[os.path.join(godot_cpp, "bin")])
env.Append(LIBS=["godot-cpp.linux.template_debug.arm64"])
env.Append(LINKFLAGS=["-static-libgcc", "-static-libstdc++", "-pthread"])

sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "bin/libuntitled_sandbox.linux.template_debug.arm64.so",
    source=sources,
)

env.NoCache(library)
Default(library)
