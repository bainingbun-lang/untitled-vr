(module
  (global $last_id (mut i32) (i32.const 0))
  (func (export "get_last_id") (result i32)
    (global.get $last_id)
  )
  (func (export "handle_event") (param $event_id i32) (param $payload i32) (result i32)
    (global.set $last_id (local.get $event_id))
    (local.get $payload)
    (i32.const 1)
    (i32.add)
  )
  (func (export "_mod_init") (result i32)
    (i32.const 0)
  )
)